@model WebApplication1.Models.ContactModel

@{
    ViewData["Title"] = "Contact Us Page";
    ViewData["HideImage"] = true;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-4 col-md-6 col-sm-12">

            <h2>Contact Us</h2>

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            @using (Html.BeginForm("ShowData", "Home", FormMethod.Post))
            {

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Your Name",
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Name,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter your name"
                        })

                    @Html.ValidationMessageFor(m => m.Name,
                        "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, "Email Address",
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "Enter your email"
                        })

                    @Html.ValidationMessageFor(m => m.Email,
                        "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Subject,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Subject,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter subject"
                        })

                    @Html.ValidationMessageFor(m => m.Subject,
                        "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Message, "Your Message",
                        new { @class = "form-label" })

                    @Html.TextAreaFor(m => m.Message, 4, 40,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Write your message here"
                        })

                    @Html.ValidationMessageFor(m => m.Message,
                        "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit
                </button>
            }
        </div>
    </div>
</div>



