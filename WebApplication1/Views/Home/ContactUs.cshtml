@{
    ViewData["Title"] = "Contact Us Page";
    ViewData["HideImage"] = true;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-4 col-md-6 col-sm-12">

            <h2>Contact Us</h2>
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            @using (Html.BeginForm("ShowData", "Home", FormMethod.Post))
            {
                <div class="mb-3">
                    @Html.Label("Name", "Your Name", new { @class = "form-label" })
                    @Html.TextBox("Name", null, new
                    {
                        @class = "form-control",
                        placeholder = "Enter your name"
                    })
                </div>

                <div class="mb-3">
                    @Html.Label("Email", "Email Address", new { @class = "form-label" })
                    @Html.TextBox("Email", null, new
                    {
                        @class = "form-control",
                        type = "email",
                        placeholder = "Enter your email"
                    })
                </div>

                <div class="mb-3">
                    @Html.Label("Subject", "Subject", new { @class = "form-label" })
                    @Html.TextBox("Subject", null, new
                    {
                        @class = "form-control",
                        placeholder = "Enter subject"
                    })
                </div>

                <div class="mb-3">
                    @Html.Label("Message", "Your Message", new { @class = "form-label" })
                    @Html.TextArea("Message", null, 4, 40, new
                    {
                        @class = "form-control",
                        placeholder = "Write your message here"
                    })
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit
                </button>
            }

        </div>
    </div>
</div>


